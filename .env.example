# OpenAI 兼容 LLM（与 DeepSeek / OpenAI / 国内聚合网关等兼容）
# 优先读取 OPENAI_*；未设置时回退到 DEEPSEEK_*（兼容旧配置）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
# 主模型（也可用 LLM_MODEL）
OPENAI_MODEL=deepseek-chat
# 备用模型，逗号分隔，主模型失败时依次尝试
LLM_FALLBACK_MODELS=
# 多 Key 负载均衡（可选，逗号分隔；配置后优先于单 Key）
# 统一通过 LiteLLM 调用，可接 AIHubMix / Gemini / OpenAI兼容 / DeepSeek / 通义千问 / Claude 等
LLM_API_KEYS=
# 按 provider 分组的 Key 池（可选，模型会自动匹配对应池，避免不同厂商 Key 混用）
OPENAI_API_KEYS=
ANTHROPIC_API_KEYS=
GEMINI_API_KEYS=
QWEN_API_KEYS=
DEEPSEEK_API_KEYS=
# 示例模型名（按 LiteLLM 规范填写，逗号分隔）
# OPENAI_MODEL=openai/gpt-4o-mini
# LLM_FALLBACK_MODELS=anthropic/claude-3-5-sonnet-20240620,gemini/gemini-1.5-pro,qwen/qwen-plus
# 兼容旧变量名（OPENAI_API_KEY 为空时生效）
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 推送渠道（逗号分隔，按顺序尝试；至少配置完整一种）
# email | feishu | wechat | telegram | discord | dingtalk
NOTIFY_CHANNELS=email

# Email SMTP（NOTIFY_CHANNELS 含 email 时必填）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_auth_code
MAIL_FROM=your_email@qq.com
MAIL_TO=receiver1@qq.com,receiver2@qq.com

# 飞书群机器人 Webhook
FEISHU_WEBHOOK_URL=

# 企业微信机器人 Webhook
WECHAT_WEBHOOK_URL=

# Telegram Bot（https://core.telegram.org/bots/api#sendmessage）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 论坛话题 ID（可选）
TELEGRAM_MESSAGE_THREAD_ID=

# Discord Incoming Webhook
DISCORD_WEBHOOK_URL=

# 钉钉自定义机器人 Webhook；若机器人开启「加签」则填写密钥
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=

# System
TIMEZONE=Asia/Shanghai
RUN_TIME=18:30

# 行为
# TRADING_DAY_CHECK_ENABLED=true 时，非交易日跳过分析；设为 false 或命令行 --force-run 可强制执行
TRADING_DAY_CHECK_ENABLED=true
# 乖离率(相对 MA20)绝对值超过该阈值(%)时标为追高预警（规则层 bias_alert）
BIAS_THRESHOLD=5.0
# 逐股拉取间隔（秒），减轻数据源限流，0 表示不延迟
ANALYSIS_DELAY_SECONDS=0
# 历史评估固定窗口（交易日序号，逗号分隔），例如 1,3,5 或 1,2,5,10
ACCURACY_WINDOWS=1,3,5

# Tavily 新闻摘要（可选，填写 TAVILY_API_KEY 后自动启用；TAVILY_ENABLED=false 可关闭）
# https://tavily.com/
TAVILY_API_KEY=
TAVILY_ENABLED=true
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic
# topic: general | news | finance
TAVILY_TOPIC=news
# time_range: day | week | month | year（或 d/w/m/y）
TAVILY_TIME_RANGE=week
TAVILY_INCLUDE_ANSWER=true
# 个股 Tavily 请求间隔（秒），降低限流风险
TAVILY_REQUEST_DELAY_SECONDS=1
# 写入单股 news_digest 的最大字符数（控制 LLM 上下文体积）
NEWS_DIGEST_MAX_CHARS=2000
# 将 Tavily 的 answer 与每条检索结果的 title/content 译为简体中文（单次模型调用）；复用 DEEPSEEK_* 接口
TAVILY_TRANSLATE_ANSWER_TO_ZH=true
